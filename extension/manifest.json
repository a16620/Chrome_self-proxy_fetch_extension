{
  "name": "API 호출기",
  "description": "API CORS우회 호출을 위한 프로그램",
  "version": "2.2",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "api/background.js"
  },
  "permissions" : ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"]
}